# CoreOS environment variables — copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored). Placeholders only here.

# --- Backend (FastAPI / main.py) ---

# OpenAI API key — used by the AI Omni-bar intent parser (/api/process-input).
OPENAI_API_KEY=

# Gemini API key — reserved for future use (not currently consumed by the code).
GEMINI_API_KEY=

# Path to the SQLite database file the backend opens.
COREOS_DB_PATH=coreos.db

# Host / port the backend binds to when run via `python main.py`.
# Default is loopback: the browser and the phone reach CoreOS through the
# trusted HTTPS front door (dev/Caddyfile — Caddy listens on :443 on every
# interface and proxies to 127.0.0.1:8080), so the backend never needs a
# LAN-facing socket. Set COREOS_HOST=0.0.0.0 ONLY if you deliberately need to
# hit :8080 directly (bypasses Caddy's TLS and its X-Forwarded-For sanitising).
COREOS_HOST=127.0.0.1
COREOS_PORT=8080

# --- Phase 2: authentication & security ---

# Deployment environment: "development" or "production".
# In production the app FAILS TO START if COREOS_SESSION_SECRET or
# COREOS_ALLOWED_ORIGINS is missing/insecure.
COREOS_ENV=development

# Secret used to HMAC session tokens before they are stored (so a DB leak of
# session hashes cannot be turned into usable session tokens).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. Leave blank in dev to use an insecure dev-only default.
COREOS_SESSION_SECRET=

# Session lifetime in seconds (default 604800 = 7 days).
COREOS_SESSION_TTL_SECONDS=604800

# Comma-separated list of browser origins allowed to call the API with cookies.
# REQUIRED (no default) when COREOS_ENV=production.
# In development, if left blank, a safe dev allowlist is used automatically:
#   https://coreos.local, https://localhost:3000, http://localhost:3000,
#   http://127.0.0.1:3000
# For LAN/physical-device testing, add your own machine's LAN origin explicitly
# (e.g. http://<your-LAN-IP>:3000) rather than relying on a hardcoded default.
# With the Phase 5A same-origin reverse proxy, browser calls are same-origin and
# do not need CORS at all — this list only matters for direct/no-proxy access.
COREOS_ALLOWED_ORIGINS=

# Session cookie "Secure" attribute.
#   production           -> always on (cannot be disabled).
#   plain http localhost -> leave blank / 0.
#   Phase 5A HTTPS proxy -> set to 1 (the browser-facing origin is https://).
COREOS_COOKIE_SECURE=

# --- Phase 5A: secure development (HTTPS reverse proxy) ---

# Hostname the browser/iPhone uses for the single trusted HTTPS origin.
# Used by dev/Caddyfile (TLS + routing) and by next.config.ts (allowedDevOrigins).
# Change only if `coreos.local` is inconvenient on this machine/network.
COREOS_DEV_HOST=coreos.local

# SERVER-SIDE loopback address of the FastAPI backend that Next.js forwards
# "/api/*" to (see next.config.ts rewrites). Never sent to the browser. Keep it
# an internal address — do NOT point it at a public URL.
COREOS_BACKEND_ORIGIN=http://127.0.0.1:8080

# --- Phase 5C: verified places provider ---

# Which place-search provider to use:
#   auto (default) -> Google if GOOGLE_PLACES_API_KEY is set, else OpenStreetMap
#   osm            -> OpenStreetMap / Overpass (free, no key; identity + coords,
#                     NO ratings / open-now)
#   google         -> Google Places API (New) — rich data; needs the key below
COREOS_PLACES_PROVIDER=auto

# Google Places API (New) key. SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
# Leave blank to run on OpenStreetMap. When set, CoreOS uses Google Text Search
# with a restrictive field mask. Requires a billing-enabled Google Cloud project
# with the "Places API (New)" enabled. See docs/places.md.
GOOGLE_PLACES_API_KEY=

# Overpass API endpoint (OpenStreetMap). Override only if the default is blocked
# or you run a private mirror.
COREOS_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Phase 5D: geocoding provider ("Change location" area search) ---

# Which geocoder to use: auto (default) -> Google if a key is available, else
# OpenStreetMap/Nominatim | google | osm
COREOS_GEOCODE_PROVIDER=auto

# Dedicated Geocoding API key. SERVER-SIDE ONLY — never NEXT_PUBLIC_. If blank,
# GOOGLE_PLACES_API_KEY is reused (that key must then also have the
# "Geocoding API" enabled and allowed under its API restrictions).
GOOGLE_GEOCODING_API_KEY=

# Nominatim endpoint (OpenStreetMap). CoreOS uses an explicit "Search" button
# (not keystroke autocomplete) and a descriptive User-Agent, per Nominatim's
# usage policy. Override only for a private mirror.
COREOS_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- Phase 5F: weather (contextual infrastructure, not a feature) ---
# Weather provider. Only "open-meteo" today; the architecture is provider-neutral
# so another provider can be added later without touching downstream consumers.
COREOS_WEATHER_PROVIDER=open-meteo
# Open-Meteo forecast endpoint. FREE, no API key for non-commercial use, returns
# WMO weather codes and TARGET-LOCATION local time (timezone=auto). Override only
# for a private mirror / self-hosted Open-Meteo.
COREOS_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Reminder scheduler poll interval (Phase 1).
COREOS_REMINDER_POLL_SECONDS=60
# Set to 0 to disable the background reminder scheduler (e.g. in tests).
COREOS_SCHEDULER_ENABLED=1

# --- One-off legacy-user bootstrap (see bootstrap_user.py) ---
# Used ONLY by `python bootstrap_user.py` to set/reset a password for an
# existing account. Never read by the running app. Do not commit real values.
COREOS_BOOTSTRAP_EMAIL=
COREOS_BOOTSTRAP_PASSWORD=

# --- Frontend (Next.js) ---

# Base URL the browser uses to reach the backend API.
#
#   BLANK (recommended)  -> same-origin: the browser calls "/api/..." on the
#                           page's own origin and Next.js proxies it to the
#                           backend server-side. Works for the Phase 5A HTTPS
#                           proxy (https://coreos.local) AND plain desktop dev
#                           (http://localhost:3000). No mixed-content risk.
#
#   http://localhost:8080 -> direct/no-proxy desktop dev only. An https:// page
#                           with an http:// base is rejected at runtime (mixed
#                           content), so never use this from the HTTPS proxy.
#
# Do NOT set this to a "http://<LAN-IP>:8080" value — that is the insecure
# pattern Phase 5A replaces.
NEXT_PUBLIC_API_BASE_URL=
